# Copy to .env and fill in. NEVER commit .env.
DISCORD_BOT_TOKEN=
OWNER_ID=
# Private GitHub release updater (optional; use a fine-grained token with
# read-only Contents access to this repository; never commit the real token).
# OMNICORE_AUTO_UPDATE=1
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=necromancerelux-ux/OmniCore_Rust
# OMNICORE_UPDATE_INTERVAL_MINUTES=5
# Encrypted SQLite backups (optional; disabled unless explicitly enabled).
# Use a separate GitHub token with Contents read/write for release assets.
# Generate a 32-byte key and store it only on the host; keep an offline copy elsewhere.
# OMNICORE_BACKUP_ENABLED=1
# GITHUB_BACKUP_TOKEN=github_pat_...
# OMNICORE_BACKUP_KEY=<32-byte key as 64 hex characters or base64>
# OMNICORE_BACKUP_INTERVAL_HOURS=6
# OMNICORE_BACKUP_RETENTION_DAYS=14
# DISCORD_GUILD_ID=            # dev only: instant command registration in one guild
# Music is OFF unless LAVALINK_HOST is set. Only set it if a Lavalink server is really
# running/reachable (Node panels usually have none: leave it out, or use a hosted node).
# LAVALINK_HOST=127.0.0.1:2333
# LAVALINK_PASSWORD=           # required unless Lavalink is on localhost
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost   # Google blocks the old urn:ietf:wg:oauth:2.0:oob flow
# Needs "Message Content Intent" enabled in the Discord developer portal (WoS relay).
# OMNICORE_SECRET_KEY=          # long random string: encrypts stored credentials (Oracle, WoS key, Google) at rest.
#                               # Keep it ONLY in the host environment. If you lose it, reconnect those services.
# EMOJI_GUILD_ID=               # optional: force the home server for custom material emoji.
#                               # If unset, the first server the bot is in is auto-picked.
# --- Optional community gift-code feed (all codes still get live-validated) ---
# GIFTCODE_SYNC_ENABLED=1
# GIFTCODE_SYNC_API_URL=https://gift-code-api.whiteout-bot.com/giftcode_api.php
# GIFTCODE_SYNC_API_KEY=        # required to enable this source; no built-in/default key is used.
# GIFTCODE_WOSTOOLS_ENABLED=1   # WoSTools is the default secondary source.
# GIFTCODE_WOSTOOLS_URL=https://wostools.net/gift-codes
# GIFTCODE_WOSORACLE_ENABLED=1  # Oracle is the fallback unless marked primary below.
# GIFTCODE_WOSORACLE_PRIMARY=0  # set to 1 to prefer Oracle over WoSTools.
# GIFTCODE_REVALIDATE_ENABLED=1 # recheck old active codes periodically; 0 disables revalidation.

# --- TLS / network (only if you see `invalid peer certificate: UnknownIssuer`) ---
# OMNICORE_CA_FILE=/etc/ssl/certs/ca-certificates.crt   # extra trusted CA bundle
# OMNICORE_NO_PROXY=1                                   # ignore HTTP(S)_PROXY from the host
# OMNICORE_INSECURE_TLS=1                               # last resort: skip cert checks
